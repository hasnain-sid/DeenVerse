# ── Server ────────────────────────────────────────────
PORT=8081
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────
# NOTE: the code reads MONGO_URI (not MONGODB_URI).
# Transactions (course enrollment) require a replica set — use Atlas
# or a local replica set; a standalone local mongod will fail.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/deenverse?retryWrites=true&w=majority
MONGO_POOL_SIZE=10

# ── Auth ──────────────────────────────────────────────
TOKEN_SECRET=your-jwt-access-token-secret
REFRESH_TOKEN_SECRET=your-jwt-refresh-token-secret
# Comma-separated Mongo user ids with admin powers (cached at boot — restart after changes)
ADMIN_IDS=

# ── Frontend / CORS ──────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_URL_PROD=https://deen-verse-front.vercel.app
# Extra allowed origins, comma-separated (optional)
CORS_ORIGINS=

# ── Redis (optional — features degrade gracefully) ───
# Either a URL...
REDIS_URL=
# ...or host/port/password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── AWS General ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional per-service region overrides
AWS_SES_REGION=
AWS_IVS_REGION=

# ── AWS S3 (File Storage) ────────────────────────────
S3_BUCKET_AVATARS=deenverse-avatars
S3_BUCKET_MEDIA=deenverse-media
S3_BUCKET_STREAMS=deenverse-streams
S3_BUCKET_RECORDINGS=deenverse-recordings
CDN_BASE_URL=https://cdn.deenverse.com

# ── AWS SES (Email) ──────────────────────────────────
SES_FROM_EMAIL=noreply@deenverse.com

# ── LiveKit (Virtual Classrooms) ─────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Web Push (VAPID) ─────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@deenverse.com

# ── Stripe (Payments) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_...
COURSE_COMMISSION_RATE=0.30
STRIPE_STUDENT_PRICE_ID=price_...
STRIPE_PREMIUM_PRICE_ID=price_...

# ── Quran content API (defaults work; override if needed) ──
ALQURAN_CLOUD_BASE_URL=
QURAN_ARABIC_EDITION=
QURAN_TRANSLATION_EDITION=
QURAN_TAFSIR_EDITION=
QURAN_AUDIO_EDITION=
